SQLITE_PATH=./data/community-graph.sqlite
API_KEY=change-me

# HTTP server bind. Vlastní názvy (ne HOSTNAME/PORT) - HOSTNAME si v Dockeru drží runtime
# pro ID kontejneru a přebilo by tuhle hodnotu.
SERVER_HOST=0.0.0.0
SERVER_PORT=3004

# LLM enrichment (krok 2) - vyplň jen klíče pro providera zvoleného v config.toml ([llm] provider).
# provider = "anthropic"
LLM_ANTHROPIC_API_KEY=
# provider = "openai-compatible" (OpenAI, Ollama, vLLM, LM Studio, vlastní systém...)
LLM_OPENAI_COMPATIBLE_BASE_URL=
LLM_OPENAI_COMPATIBLE_API_KEY=
# provider = "gemini"
LLM_GEMINI_API_KEY=
# provider = "geek-ai-scheduler" - synchronní fronta před Ollamou (viz AI_INTEGRATION.md)
#   BASE_URL = adresa, kde scheduler poslouchá (bez /v1/schedule). Když běží na hostu a
#              community-graph v Dockeru, použij http://host.docker.internal:<port>
#              (v docker-compose.yml je k tomu extra_hosts).
#   NODE     = povinný identifikátor tohoto uzlu; scheduler podle něj navyšuje prioritu
#   pozn.: [llm] request_timeout_ms v config.toml musí být DELŠÍ než serverový
#          request_timeout_ms scheduleru (výchozí 300000 ms), jinak klient utne spojení dřív
LLM_GEEK_AI_SCHEDULER_BASE_URL=
LLM_GEEK_AI_SCHEDULER_NODE=

# Neo4j (krok 3 - graph write). Výchozí hodnoty sedí na docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=community-graph-dev
